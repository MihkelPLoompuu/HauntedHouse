@model IEnumerable<HauntedHouse.Models.Hunters.HunterIndexViewModel>

@{
    int rowNumber = 1;
    int currentRow = 1;
    int currentTile = 1;
    int tilesInRow = 6;
}
<div>
    <a asp-action="Add" asp-controller="Hunters" type="submit" class="btn btn-primary">Start Mission</a>
    <a asp-action="Create" asp-controller="Hunters" class="btn btn-primary">Create new Hunters</a>
</div>
<div class="h1">Your Hunter:</div>
<form method="post">
    <table class="table table-hover" id="tableWH">
        <thead>
            @if (!Model.Any())
            {
                <tr>
                    <th scope="col" colspan="4" class="TColor">
                        <span>#playernamehere#</span>
                        <span>does not have any hunters yet.</span>
                    </th>
                </tr>
            }
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <table class="HIT">
                    <tr><td colspan="2">HunterName</td></tr>
                    <tr><td colspan="2"><img src="~/lib/gamesset/image/premadehunters/Doc.png" /></td></tr>
                    <tr><td>Level</td></tr>
                    <tr><td colspan="2">XPBAROBJECT</td></tr>
                </table>
                rowNumber++;
            }
            else
            {
                @foreach (var hunter in Model)
                {                     
                <td>
                    <table class="HIT">
                        <div>Hunter</div>
                        <tr class="TColor"><td colspan="2">@hunter.HunterName</td></tr>
                        <tr class="TColor"><td colspan="2"><img width="256" src="~/lib/gamesset/image/premadehunters/NotImplementedImage.png" /></td></tr>
                        <tr class="TColor"><td>@hunter.HunterLevel</td></tr>
                        <tr class="TColor"><td colspan="2">XPBAROBJECT</td></tr>
                    </table>
                    <div class="Action-btn">
                        Admin Actions
                        <br />
                        <a asp-action="details" asp-controller="hunters" asp-route-id="@hunter.ID" class="btn btn-info">HunterDetails</a>
                        <a asp-action="update" asp-controller="hunters" asp-route-id="@hunter.ID" class="btn btn-info">HunterConfigure</a>
                        <br />
                        <a asp-action="delete" asp-controller="hunters" asp-route-id="@hunter.ID" class="btn btn-info">HunterDelete</a>
                    </div>
                </td>
                    rowNumber++;
                }
            }
        </tbody>
    </table>
</form>