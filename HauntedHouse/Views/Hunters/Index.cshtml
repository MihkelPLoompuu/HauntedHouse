@model IEnumerable<HauntedHouse.Models.Hunters.HunterIndexViewModel>

@{
    int rowNumber = 1;
}
<div>
    <a asp-action="Add" asp-controller="Hunters" type="submit" class="btn btn-primary">Start Mission</a>
    <a asp-action="Create" asp-controller="Hunters" class="btn btn-primary">Create new Hunters</a>
</div>
@*User can start shop using ADD function, to obtain new titan. In controller, this is called "PlayerSoloMission"*@

<div class="h1">Your Hunter:</div>
<form method="post">
    <table class="table table-hover">
        <thead>
            <tr>
                <th scope="col">#</th>
                <th scope="col">ID</th>
                <th scope="col">Name</th>
                <th scope="col">Level</th>
                <th scope="col">Image</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var guy in Model)
            {
                <tr>
                    <td>@rowNumber</td>
                    <td>@guy.ID</td>
                    <td>@guy.HunterName</td>
                    <td>@guy.HunterLevel</td>
                    <td>
                        <a asp-action="Details" asp-controller="Hunters" asp-route-id="@guy.ID" class="Details"></a>
                        <br />
                        <a asp-action="Update" asp-controller="Hunters" asp-route-id="@guy.ID" class="Update"></a>
                        <br />
                        <a asp-action="Delete" asp-controller="Hunters" asp-route-id="@guy.ID" class="Delete"></a>
                    </td>
                </tr>
                rowNumber++;
            }
        </tbody>
    </table>
</form>