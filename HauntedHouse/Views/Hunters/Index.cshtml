@model IEnumerable<HauntedHouse.Models.Hunters.HunterIndexViewModel>

@{
    int rowNumber = 1;
}
<div>
    <a asp-action="Add" asp-controller="Hunters" type="submit" class="btn btn-primary">Start Mission</a>
    <a asp-action="Create" asp-controller="Hunters" class="btn btn-primary">Create new Hunters</a>
</div>

<div class="h1">Your Hunter:</div>
<form method="post">
    <table class="table table-hover">
        <thead>
            <tr>
                <th scope="col">#</th>
                <th scope="col">ID</th>
                <th scope="col">Name</th>
                <th scope="col">Level</th>
                <th scope="col">Image</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var hunter in Model)
            {
                <tr>
                    <td>@rowNumber</td>
                    <td>@hunter.ID</td>
                    <td>@hunter.HunterName</td>
                    <td>@hunter.HunterLevel</td>
                    <td>
                        <a asp-action="details" asp-controller="hunters" asp-route-id="@hunter.ID" class="btn btn-info">HunterDetails</a>
                        <br />
                        <a asp-action="update" asp-controller="hunters" asp-route-id="@hunter.ID" class="btn btn-info">HunterConfigure</a>
                        <br />
                        <a asp-action="delete" asp-controller="hunters" asp-route-id="@hunter.ID" class="btn btn-info">HunterDelete</a>
                    </td>
                </tr>
                rowNumber++;
            }
        </tbody>
    </table>
</form>