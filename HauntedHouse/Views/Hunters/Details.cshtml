@model HauntedHouse.Models.Hunters.HunterDetailsViewModel

<h1> @Html.DisplayFor(model => model.HunterName) </h1>

<div>
    <h4> My</h4>
    <hr />
    <dl class="row">
        <div class="form-group row">
            <label asp-for="ID" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(model => model.ID)
        </div>
        <div class="form-group row">
            <label asp-for="HunterName" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(model => model.HunterName)
        </div>
        <div id="imagediv">
            @foreach (var image in Model.Image)
            {
                <partial name="_Images" model="image"/>
            }
        </div>

        <div class="form-group row">
            <label asp-for="HunterHealth" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(model => model.HunterHealth)
        </div>
        <div class="form-group row">
            <label asp-for="HunterLevel" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(model => model.HunterLevel)
        </div>
      
        <div class="form-group row">
            <label asp-for="HunterXP" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(model => model.HunterXP)
        </div>
        <div class="form-group row">
            <label asp-for="HunterXPNextLevel" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(model => model.HunterXPNextLevel)
        </div>

        <div class="form-group row">
            <label asp-for="HunterXPNextLevel" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(model => model.HunterXPNextLevel)
        </div>

        <div class="form-group row">
            <label asp-for="HunterStatus" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(model => model.HunterStatus)
        </div>



        <div class="form-group row">
            <label asp-for="PrimaryAttackName" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(model => model.PrimaryAttackName)
            <label asp-for="PrimaryAttackPower" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(model => model.PrimaryAttackPower)
        </div>
        <div class="form-group row">
            <label asp-for="SecondaryAttackName" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(model => model.SecondaryAttackName)
            <label asp-for="SecondaryAttackPower" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(model => model.SecondaryAttackPower)
        </div>
        <div class="form-group row">
            <label asp-for="SpecialAttackName" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(model => model.SpecialAttackName)
            <label asp-for="SpecialAttackPower" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(model => model.SpecialAttackPower)
        </div>

    </dl>

    <a asp-action="Index" asp-controller="hunters" class="btn btn-secondary">Back</a>
</div>