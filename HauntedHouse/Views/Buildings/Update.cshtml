@using HauntedHouse.Core.Domain
@model HauntedHouse.Models.Buildings.BuildingCreateViewModel

<div>
    <form method="post" asp-action="Update" enctype="multipart/form-data">

        <div class="form-group-row">
            <label asp-for="BuildingName" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="BuildingName" class="form-control" />
            </div>
        </div>

        <div class="form-group row">
            <label asp-for="BuildingType" class="col-sm-10 col-form-label"></label>
            <div class="col-sm-10">
                <select asp-for="BuildingType" asp-items="Html.GetEnumSelectList<BuildingType>()" class="form-control">
                    <option value="">Select type</option>
                </select>
                <span asp-validation-for="BuildingType" class="text-danger "></span>
            </div>
        </div>
        @{
            var breakpoint = "";
        }
        <input asp-action="Update" asp-controller="Rooms" type="submit"
               class="btn btn-primary" value="Change" />
        <a asp-action="index" class="btn btn-primary">Cancel</a>

    </form>
</div>